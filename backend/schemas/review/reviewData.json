{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reviewer_id": {
      "type": "integer",
      "minimum": 1
    },
    "reviewee_id": {
      "type": "integer",
      "minimum": 1
    },
    "session_event_id": {
      "type": "integer",
      "minimum": 1
    },
    "overall_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string",
      "maxLength": 255
    },
    "role": {
      "type": "string",
      "enum": ["provider", "requester"]
    }
  },
  "required": [
    "reviewer_id",
    "reviewee_id",
    "session_event_id",
    "overall_rating",
    "role"
  ],
  "additionalProperties": false
}
