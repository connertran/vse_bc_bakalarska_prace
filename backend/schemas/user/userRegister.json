{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "alt_email": {
      "type": "string",
      "format": "email"
    },
    "password": {
      "type": "string",
      "minLength": 8
    },
    "tel_number": {
      "type": "string",
      "minLength": 9,
      "maxLength": 15
    },
    "bio": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "year_of_study": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    }
  },
  "required": [
    "name",
    "email",
    "alt_email",
    "password",
    "tel_number",
    "bio",
    "year_of_study"
  ]
}
