{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 155
    },
    "semester": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "faculty": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 255
    }
  },
  "required": ["code", "name", "semester", "faculty", "url"]
}
